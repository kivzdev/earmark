# Copy to .env (next to this file) and fill in what you use. .env is never committed.

# ── the helper on your computer ────────────────────────────────────────────────────────────────────────────────
# speech to text: parakeet (Apple Silicon, default there), whisper (Windows, Linux, Intel Macs) or cloud
# EARMARK_ENGINE=parakeet
# EARMARK_MODEL=mlx-community/parakeet-tdt-0.6b-v2
# where the library lives (default: ~/Library/Application Support/Earmark, %APPDATA%\Earmark, ~/.local/share/earmark)
# EARMARK_HOME=

# let Claude Haiku 5.5 pick the moments and the expressions in them (about a cent or two per hour of stream)
# ANTHROPIC_API_KEY=
# EARMARK_AI_MODEL=claude-haiku-5-5
# the extension connects by itself; 0 makes you allow it on the dashboard
# EARMARK_AUTO_PAIR=1
# moments nobody kept lose their video after this many days (the transcript stays)
# EARMARK_KEEP_DAYS=14

# a cheap cloud engine instead (any OpenAI-compatible /audio/transcriptions API; Groq is about $0.04 an hour)
# EARMARK_ENGINE=cloud
# GROQ_API_KEY=
# EARMARK_CLOUD_ASR_URL=https://api.groq.com/openai/v1
# EARMARK_CLOUD_ASR_MODEL=whisper-large-v3-turbo

# a private copy online (optional; deploy this repository to Vercel first — see the README)
# EARMARK_SYNC_URL=https://earmark.example.com
# EARMARK_SYNC_TOKEN=
# EARMARK_SYNC_CLIPS_PER_DAY=25
# EARMARK_SYNC_BUDGET_MB=900

# ── the online copy (set these in Vercel's project settings, not here) ────────────────────────────────────────
# EARMARK_ORIGIN=https://earmark.example.com
# SESSION_SECRET=           (32+ random characters)
# EARMARK_SETUP_CODE=       (makes the first passkey)
# EARMARK_SYNC_TOKEN=       (the same value as the helper's)
