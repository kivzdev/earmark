{
  "manifest_version": 3,
  "name": "Earmark",
  "version": "0.1.0",
  "description": "Watches Twitch with you and keeps the everyday English you hear, with the clip it was said in. Everything stays on your computer.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Earmark",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.twitch.tv/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:3276/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
